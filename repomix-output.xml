  text-align: center;
  cursor: move;
}

.remove-chord {
  position: absolute;
  top: -6px;
  right: -6px;
  background: #ff5252;
  color: white;
  border: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  font-size: 10px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
