<file path="src/index.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

@font-face {
  font-family: 'Architects Daughter';
  src: url('fonts/ArchitectsDaughter-Regular.ttf') format('truetype');
  font-weight: 600;
  font-style: normal;
}

:root {
  /* Tonalidad de papel limpio y mate, con tarjetas ligeramente texturizadas en blanco papel */
  --bg-main: #F5F4F0;
  --bg-card: #FAF9F5;
  --bg-card-hover: #F2F0EA;
  --bg-input: #EBE9E1;
  --border-color: #D3CEBE;
  --border-focus: #2C2A29;

  --text-primary: #2C2A29;
  --text-secondary: #5C5853;
  --text-muted: #8C867E;

  --accent-primary: #2C2A29;
  --accent-hover: #1A1918;
  --accent-text: #FAF9F5;
  --accent-subtle: #E8E5DC;

  /* Estética Real Book clásico: trazos limpios negros/grafito sobre papel limpio */
  --chord-text: #1A1918;
  --chord-bg: #FFFFFF;
}

body {
  background-color: var(--bg-main);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  min-height: 100vh;
}

/* ==========================================================================
   COMPONENTES Y CLASES RESPONSIVAS GLOBALES
   ========================================================================== */
@layer components {

  /* Contenedor principal de la App */
  .app-container {
    @apply min-h-screen w-full bg-[var(--bg-main)] text-[var(--text-primary)] px-3 py-4 sm:px-6 sm:py-6 lg:px-8;
  }

  /* Tarjeta general (Setlists, Canciones, Secciones) */
  .app-card {
    @apply bg-[var(--bg-card)] border-2 border-[#2C2A29] rounded-lg sm:rounded-xl p-3.5 sm:p-5 shadow-[2px_2px_0px_#2C2A2926] sm:shadow-[3px_3px_0px_#2C2A2926] transition-all;
  }

  .app-card-hover {
    @apply hover:bg-[var(--bg-card-hover)] hover:shadow-[4px_4px_0px_#2C2A2933] cursor-pointer active:translate-x-[1px] active:translate-y-[1px];
  }

  /* Campos de Entrada / Inputs */
  .app-input {
    @apply bg-[var(--bg-input)] border-[1.5px] border-[var(--border-color)] text-[var(--text-primary)] min-h-[44px] sm:min-h-[48px] rounded-lg sm:rounded-xl px-3.5 sm:px-4 text-sm sm:text-base w-full transition-colors focus:outline-none focus:border-[var(--border-focus)] focus:ring-2 focus:ring-[#2C2A29]/15;
  }

  /* Botón Principal (Acciones clave como Agregar, Guardar, Play) */
  .app-button-primary {
    @apply bg-[var(--accent-primary)] text-[var(--accent-text)] font-bold min-h-[44px] sm:min-h-[48px] px-4 sm:px-6 rounded-lg sm:rounded-xl text-sm sm:text-base border-[1.5px] border-[#1A1918] flex items-center justify-center gap-2 transition-colors hover:bg-[var(--accent-hover)] active:scale-[0.98];
  }

  /* Botón Secundario / Acción Suave */
  .app-button-secondary {
    @apply bg-[var(--accent-subtle)] text-[var(--text-primary)] font-semibold min-h-[44px] sm:min-h-[48px] px-3.5 sm:px-5 rounded-lg sm:rounded-xl text-sm sm:text-base border border-[var(--border-color)] flex items-center justify-center gap-2 transition-colors hover:bg-[var(--border-color)] active:scale-[0.98];
  }

  /* ------------------------------------------------------------------------
     CIFRADO Y CASILLAS DENTRO DEL REAL BOOK (RESPONSIVO Y ADAPTABLE)
     ------------------------------------------------------------------------ */
  .chord-box-global {
    font-family: 'Architects Daughter', cursive;
    @apply bg-[var(--chord-bg)] border-[1.5px] border-[#2C2A29] text-[var(--chord-text)] font-extrabold text-center rounded-md shadow-[1px_1px_0px_#2C2A291F] flex items-center justify-center select-none transition-all w-full h-full;

    padding: 0.25rem 0.05rem;
    line-height: 2;
    font-size: clamp(1.4rem, 2.2vw, 1.4rem);
  }

  /* Ajustes dinámicos de tipografía según número de divisiones por compás */
  .divisiones-3 .chord-box-global {
    font-size: clamp(0.7rem, 1.4vw, 0.95rem);
    padding: 0.15rem 0.05rem;
    letter-spacing: -0.02em;
  }

  .divisiones-4 .chord-box-global {
    font-size: clamp(0.6rem, 1.1vw, 0.85rem);
    padding: 0.1rem 0.05rem;
    letter-spacing: -0.03em;
  }

  .divisiones-5 .chord-box-global,
  .divisiones-6 .chord-box-global {
    font-size: clamp(0.55rem, 0.9vw, 0.75rem);
    padding: 0.1rem 0rem;
    letter-spacing: -0.04em;
  }
}
