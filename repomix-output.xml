  background: #f9f9f9;
  flex: 1;
}

.chord-box.hovered {
  border-color: #64b5f6;
  background: #e3f2fd;
}

.box-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid #eee;
}

.box-header span {
  font-weight: bold;
  color: #333;
}

.divide-select {
  padding: 5px 8px;
  border-radius: 4px;
  border: 1px solid #ddd;
  background: white;
}

.divisions-container {
  display: flex;
  gap: 8px;
  min-height: 120px;
}

.division {
  flex: 1;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 4px;
  padding: 5px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-height: 100px;
}

/* Estilos específicos para cada número de divisiones */
.divisions-1 .division {
  width: 100%;
}

.divisions-2 .division {
  width: calc(50% - 4px);
}

.divisions-3 .division {
  width: calc(33.33% - 5.33px);
}

.divisions-4 .division {
  width: calc(25% - 6px);
}

.divisions-6 .division {
  width: calc(16.66% - 6.66px);
}

.divisions-8 .division {
  width: calc(12.5% - 7px);
}

.chord-item {
  padding: 8px 12px;
  background: white;
