                className="flex-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 py-2 px-3"
              >
                {Object.keys(circulos).map(t => (
                  <option key={t} value={t}>{t}</option>
